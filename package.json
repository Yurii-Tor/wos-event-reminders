{
  "name": "wos-event-reminders",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply wos-event-reminders-db --local",
    "db:remote": "wrangler d1 migrations apply wos-event-reminders-db --remote",
    "db:staging:migrate": "wrangler d1 migrations apply wos-event-reminders-staging-db --remote --env staging",
    "deploy:staging": "wrangler deploy --env staging --name wos-event-reminders-staging",
    "preview:staging": "wrangler versions upload --env staging --name wos-event-reminders-staging",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.122.0"
  }
}
