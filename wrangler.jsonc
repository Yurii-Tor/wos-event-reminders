{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wos-event-reminders",
  "main": "src/index.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wos-event-reminders-db",
      "database_id": "b18f508a-a2db-49d6-a6af-b87790f45ae6",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "APP_ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wos-event-reminders-staging-db",
          "database_id": "0b5699b4-4307-41f2-853e-c64a72d80c26",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
